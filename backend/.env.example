# Producao: use um PostgreSQL privado com SSL (por exemplo, ?sslmode=require).
DATABASE_URL=postgresql+psycopg://breno:breno@localhost:5432/breno_finance
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Producao na mesma origem: deixe vazio. Em dominios separados, use origens HTTPS reais.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
ENVIRONMENT=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Durante uma rotação, mantenha temporariamente a chave anterior aqui.
JWT_PREVIOUS_SECRET_KEY=
JWT_NEXT_SECRET_KEY=
JWT_EXPIRE_MINUTES=14400
REFRESH_EXPIRE_DAYS=10
COOKIE_SECURE=false
ENFORCE_HTTPS=false
